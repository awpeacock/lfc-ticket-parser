    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "nodemailer-mock": "^2.0.9",
    "ts-jest": "^29.4.6",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.972.0",
    "@aws-sdk/lib-dynamodb": "^3.972.0",
    "@redpenguinstudio/herbert": "^1.0.1",
    "@types/nodemailer": "^7.0.5",
