{
  "name": "lfc-ticket-parser",
  "version": "2.0.0",
  "description": "Application to parse the Liverpool FC Ticket Availability page and give up-to-date details of sale dates and criteria.",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "build:aws": "tsc --build tsconfig.build.json && npx tsx deploy/build.ts",
    "build:dynamo": "npx tsx deploy/dynamo.ts",
    "deploy": "npm run build:aws && npx tsx deploy/aws.ts",
    "start": "tsc --build tsconfig.build.json && node dist/index.js",
    "test": "jest",
    "docs": "npx typedoc --disableSources",
    "lint": "npx eslint src/**/*.ts"
  },
  "author": "Alasdair Peacock",
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/client-ssm": "^3.1136.0",
    "@aws-sdk/client-sts": "^3.1136.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "nodemailer-mock": "^2.1.0",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1136.0",
    "@aws-sdk/lib-dynamodb": "^3.1136.0",
    "@redpenguinstudio/herbert": "^1.0.1",
    "@types/nodemailer": "^8.0.2",
    "archiver": "^8.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "dotenv": "^18.0.1",
    "ics": "^3.12.0",
    "nodemailer": "^10.0.10"
  }
}
