  "description": "Application to parse the Liverpool FC Ticket Availability page and give up-to-date details of sale dates and criteria.",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "build:aws": "tsc --build && node ./build.mjs",
